# Copy this file to .env and fill in at least ONE LLM key. All of these have free tiers.

# --- LLM providers (tried in LLM_PROVIDERS order; later ones are automatic fallbacks) ---
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GROQ_API_KEY=            # https://console.groq.com/keys
OPENROUTER_API_KEY=      # optional, https://openrouter.ai/keys
LLM_PROVIDERS=groq,gemini,openrouter

# Model names change over time; override here if a default is retired.
# GROQ_MODEL takes a comma-separated list: each model has its own free quota, so the app
# load-balances across them (about 3x faster). The first is preferred for planning + the report.
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Requests-per-minute pacing, set slightly under your free-tier limit.
GEMINI_RPM=10
GROQ_RPM=30

# --- Web search (optional: falls back to DuckDuckGo, which needs no key) ---
TAVILY_API_KEY=          # https://app.tavily.com  (1,000 free searches/month)

# --- RAG ---
EMBEDDING_BACKEND=onnx       # onnx (local, no quota) | gemini (free API, ~1,000 texts/day) | local | hash
VECTOR_STORE=auto        # auto | chroma | memory

# --- Research shape ---
MAX_SUB_QUESTIONS=4
MAX_PAGES_PER_WORKER=4
CHUNKS_PER_WORKER=6
WORKER_CONCURRENCY=3

# --- Public app guard rails ---
DAILY_REPORTS_PER_USER=3
